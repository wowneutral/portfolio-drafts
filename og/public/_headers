# The scene runs in a sandboxed iframe with no allow-same-origin, so its
# document has an opaque origin. Every subresource it requests is therefore
# cross-origin, and fonts are always CORS gated: without this the Lexend face
# is blocked and the browser logs an error on every single page load.
/inner-green-assets/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/audio/*
  Cache-Control: public, max-age=31536000, immutable

/work/*
  Cache-Control: public, max-age=31536000, immutable

/awards/*
  Cache-Control: public, max-age=31536000, immutable

# Sensible defaults for a static personal site. No CSP here on purpose: the
# scene is a srcDoc iframe and the page embeds Sketchfab, Spotify and Apple,
# so a CSP written blind would break more than it protects. Add one only
# after checking each of those against a real console.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
